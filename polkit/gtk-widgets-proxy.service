# Per-app proxy routing for the gtk-widgets network popup (Proxy rules).
# Started and stopped only by /usr/lib/gtk-widgets/proxy-helper, which writes
# the config; never enabled at boot (like VPNs, Proxy rules starts by hand).
# Runs as the sing-box user from the Arch package, with the capabilities of its
# own sing-box.service: TUN and routes, and process lookup for app rules.
[Unit]
Description=gtk-widgets Proxy rules (sing-box)
Documentation=https://sing-box.sagernet.org
After=network.target nss-lookup.target network-online.target

[Service]
User=sing-box
StateDirectory=gtk-widgets-proxy
StateDirectoryMode=0700
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
ExecStart=/usr/bin/sing-box -D /var/lib/gtk-widgets-proxy -c /etc/gtk-widgets/proxy/config.json run
Restart=on-failure
RestartSec=2s
LimitNOFILE=infinity
