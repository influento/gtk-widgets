// Authorise ONLY the gtk-widgets USB helper to run without a password, and only
// for an active local session in the wheel group.
//
// This matches the exact root-owned program path (action.lookup("program")) —
// NOT a substring of the command line — so it cannot be bypassed by passing a
// crafted command to pkexec. The helper validates its own arguments and target
// device, so this grants no general-purpose privilege.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/lib/gtk-widgets/usb-helper" &&
        subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
