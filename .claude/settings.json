{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash py-gate/scripts/stop-hook.sh",
            "timeout": 600
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/workbench-review",
            "timeout": 1800
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv sync --locked)",
      "Bash(bash py-gate/scripts/gate.sh)",
      "Bash(bash py-gate/scripts/gate.sh --local)",
      "Bash(bash py-gate/scripts/gate.sh --fix)",
      "Bash(uv run pytest:*)"
    ],
    "deny": [
      "Bash(uv add *)",
      "Edit(/.claude/rules/workbench.md)",
      "Edit(/.claude/agents/wb-reviewer.md)",
      "Edit(/.claude/agents/wb-demo.md)",
      "Edit(/.claude/agents/wb-judge.md)",
      "Edit(/.claude/agents/wb-worker.md)",
      "Edit(/.claude/hooks/workbench-review)",
      "Edit(/.claude/agents/wb-tester.md)",
      "Bash(pip install *)"
    ],
    "ask": [
      "Bash(stack add *)",
      "Bash(stack rm *)",
      "Bash(stack update *)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/workshop.conf)",
      "Edit(/ruff.toml)",
      "Edit(/pyrightconfig.json)",
      "Edit(/pytest.toml)",
      "Edit(/py-gate/**)",
      "Edit(/pyproject.toml)",
      "Edit(/uv.lock)"
    ]
  },
  "autoMemoryEnabled": false
}
