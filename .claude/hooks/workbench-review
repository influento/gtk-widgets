#!/usr/bin/env bash
# Generated by 'workbench init'; edit the workbench source and re-run, never this file.
# Stop hook of an item's session. After 'workbench ready <id>', when the
# session ends its turn, this hook has wb-judge judge each judged change
# that ready listed. Then, if the code changed since the last review, it has
# wb-reviewer review the branch. Each runs in a headless session. Then the
# hook gives the item's session its next step. The state is in
# <git common dir>/workbench-reviews/<id>/state, which merge reads.
set -euo pipefail
# The reviewer's session runs the project's hooks too, in the same worktree.
[ -z "${WORKBENCH_REVIEW:-}" ] || exit 0
exec python3 -c "$(cat <<'PY'
import json, os, re, subprocess, sys

# From this review on, the user decides about the findings: after two
# rounds of fixes, reviewers start to report bugs that are not there.
USER_DECIDES_FROM = 3
SCHEMA = {
    "type": "object",
    "properties": {"findings": {"type": "array", "items": {
        "type": "object",
        "properties": {
            "who": {"type": "string", "description": "One sentence: who meets the bug, and when."},
            "command": {"type": "string", "description": "The command that shows the bug, as the project's users run it."},
            "output": {"type": "string", "description": "The output that shows the bug."},
        },
        "required": ["who", "command", "output"],
    }},
        "blocked": {"type": "string", "description": "Empty when you ran each part of the project that the change touches. Otherwise, which part you could not run, and why."}},
    "required": ["findings", "blocked"],
}
JUDGE_SCHEMA = {
    "type": "object",
    "properties": {"changes": {"type": "array", "items": {
        "type": "object",
        "properties": {
            "file": {"type": "string", "description": "The path of the change, without its label, its parts and its commit."},
            "verdict": {"type": "string", "enum": ["accept", "reject", "user"]},
            "reason": {"type": "string", "description": "One or two sentences."},
        },
        "required": ["file", "verdict", "reason"],
    }}},
    "required": ["changes"],
}


def git(*args):
    r = subprocess.run(["git", *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def say(text):
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "Stop", "additionalContext": "Workbench: " + text}}))
    sys.exit(0)


hook = json.load(sys.stdin)
# wb-demo's session runs in the same worktree. It does not end the item's turn.
if hook.get("agent_type") == "wb-demo":
    sys.exit(0)
item = git("symbolic-ref", "-q", "--short", "HEAD")
common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
top = git("rev-parse", "--show-toplevel")
if not item or not common or not top:
    sys.exit(0)
folder = os.path.join(common, "workbench-reviews", item)
path = os.path.join(folder, "state")
try:
    with open(path) as fh:
        state = dict(line.rstrip("\n").split("=", 1) for line in fh if "=" in line)
except OSError:
    sys.exit(0)
ready = state.get("ready", "")
if not ready or ready == state.get("reviewed", ""):
    sys.exit(0)


def save(**changes):
    state.update(changes)
    with open(path, "w") as fh:
        fh.writelines(f"{k}={state.get(k, '')}\n" for k in ("ready", "reviewed", "count", "judges", "base", "judge_only"))


if git("rev-parse", "HEAD") != ready or git("status", "--porcelain") != "":
    save(ready="")
    say(f"the branch changed after 'workbench ready {item}', so no review ran. "
        f"Commit the change. Then run 'workbench ready {item}' again.")

short = git("rev-parse", "--short", ready)
mode = ["--permission-mode", hook["permission_mode"]] if isinstance(hook.get("permission_mode"), str) else []


# A run that did not finish keeps its number, so the next one gets a new file.
def report_for(stem):
    name, attempt = stem, 1
    while os.path.exists(os.path.join(folder, name + ".json")):
        attempt += 1
        name = f"{stem}-{attempt}"
    return os.path.join(folder, name + ".json")


def run(report, agent, prompt, schema):
    cmd = ["claude", "-p", prompt, "--agent", agent,
           "--output-format", "json", "--json-schema", json.dumps(schema)] + mode
    with open(report, "w") as out, open(report[:-len(".json")] + ".err", "w") as err:
        subprocess.run(cmd, cwd=top, stdin=subprocess.DEVNULL, stdout=out, stderr=err,
                       env=dict(os.environ, WORKBENCH_REVIEW="1"))
    with open(report) as fh:
        return json.load(fh)["structured_output"]


# A judged change is a change to an old test (M, D), or to the parts of the
# item that the user agreed or decided (I). Ready lists each one. The judge
# sees each one before the review, and no review runs until it accepts each.
try:
    with open(os.path.join(folder, "judged")) as fh:
        judged = [(line.rstrip("\n").split("\t") + [""])[:3] for line in fh if "\t" in line]
except OSError:
    judged = []
if judged:
    j = int(state.get("judges") or 0) + 1
    base = state.get("base", "")

    # A judge can return the path with its label or its parts. Keep the path.
    def bare(f):
        f = re.sub(r", sent at \S+$", "", str(f or "").strip())
        return re.sub(r"^(changed|deleted|item): | \(.*\)$", "", f).removeprefix("./")

    def label(s, p, parts):
        return {"M": f"changed: {p}", "D": f"deleted: {p}"}.get(s, f"item: {p} ({parts})")

    # The changes that workbench sent to the user after an earlier judge, by
    # path, with the commit that the judge saw. The judge accepts only the
    # user's words that the branch added after that commit.
    asked_file = os.path.join(folder, "asked")
    try:
        with open(asked_file) as fh:
            sent = dict((line.rstrip("\n").split("\t") + [""])[:2] for line in fh if line.strip())
    except OSError:
        sent = {}
    prompt = f"{item}\nbase: {base}\n\n" + "\n".join(label(*c) for c in judged)
    again = [f"{label(*c)}, sent at {sent[c[1]]}" for c in judged if c[1] in sent]
    if again:
        prompt += "\n\nWorkbench sent these to the user before:\n\n" + "\n".join(again)
    report = report_for(f"judge-{j}")
    try:
        result = run(report, "wb-judge", prompt, JUDGE_SCHEMA)
        given = {bare(v.get("file")): v for v in result["changes"]}
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        save(ready="")
        say(f"judge {j} of {short} did not finish. Its output is in {report}. Tell the user. "
            "No review runs before a judge accepts each judged change. Merge refuses this code "
            "until a review of it finishes. The user decides what follows.")
    save(judges=str(j))
    verdicts = []
    for s, p, parts in judged:
        v = given.get(p) or {"verdict": "user", "reason": "The judge gave no verdict on this change."}
        verdicts.append((label(s, p, parts), v.get("verdict"), str(v.get("reason", "")).strip(), p))

    def listed(found):
        return "\n".join(f"- {name} — {reason}" for name, _, reason, _ in found)

    def count(found):
        return f"{len(found)} change{'' if len(found) == 1 else 's'}"

    rejected = [v for v in verdicts if v[1] not in ("accept", "user")]
    asked = [v for v in verdicts if v[1] == "user"]
    to_user = asked + (rejected if j >= USER_DECIDES_FROM else [])
    if to_user:
        with open(asked_file, "w") as fh:
            fh.writelines(f"{p}\t{c}\n" for p, c in sorted((sent | {v[3]: ready for v in to_user}).items()))
    if rejected or asked:
        save(ready="")
        parts = []
        if rejected:
            text = f"did not accept {count(rejected)}:\n\n{listed(rejected)}\n\n"
            if j < USER_DECIDES_FROM:
                steps = []
                if any(not name.startswith("item: ") for name, *_ in rejected):
                    steps.append(f"For each old test in the list, restore what the reason names, as {base} has it "
                                 f"('git show {base}:<file>'), or change the test until the reason is no longer true.")
                if any(name.startswith("item: ") for name, *_ in rejected):
                    steps.append(f"For the item, restore each part that the list names, as {base} has it, except "
                                 "a part whose change the user agreed to. For that part, write in the proof what "
                                 "the user said, in the user's words, with the date that the user said it. To see that copy of the item, "
                                 f"run 'git show {base}:<file>'. Do not restore the Proof.")
                text += " ".join(steps) + " Then fix the code until the tests pass."
            else:
                text += (f"This was judge {j}. From judge {USER_DECIDES_FROM} on, the user decides about "
                         "each change that a judge does not accept. Show the user each change and its "
                         "reason. Do not change a test or the item before the user answers. Write in the "
                         "proof what the user said, in the user's words, with the date that the user said it. Then do what the user "
                         "decided.")
            parts.append(text)
        if asked:
            parts.append(f"sends {count(asked)} to the user:\n\n{listed(asked)}\n\n"
                         "Show the user each change and its reason. To show a change, run "
                         f"'git diff {base} HEAD -- <file>'. The user keeps the change, or restores what "
                         f"{base} has. Do not restore the Proof. Write in the proof what the user said, in "
                         "the user's words, with the date that the user said it. Then do what the user decided.")
        say(f"judge {j} of {short} " + "\n\nIt also ".join(parts)
            + f"\n\nCommit. Then run 'workbench ready {item}'. No review runs before a judge accepts "
            "each judged change.")

demo = (f"Run 'workbench demo {item}'. Then end your turn. wb-demo shows the user the demo and "
        "tells you how it went. Change nothing in the worktree until then.")

# Only the agreed parts of the item changed since the last review, and the judge accepted them.
if state.get("judge_only"):
    save(reviewed=ready, judge_only="")
    say(f"review {state.get('count')} saw the code of {short} already, so no review ran. {demo}")

n = int(state.get("count") or 0) + 1
report = report_for(str(n))
try:
    result = run(report, "wb-reviewer", item, SCHEMA)
    findings, blocked = result["findings"], str(result.get("blocked") or "").strip()
    if not isinstance(findings, list):
        raise TypeError(findings)
except (OSError, ValueError, KeyError, TypeError):
    # No review saw the code, so merge still refuses it.
    save(ready="")
    say(f"review {n} of {short} did not finish. Its output is in {report}. Tell the user. "
        "Do not start the demo before a review finishes. Merge refuses this code until a review of it "
        "finishes. The user decides what follows.")

lines = []
for i, f in enumerate(findings, 1):
    lines.append(f"{i}. {f.get('who', '')}")
    lines.append(f"   command: {f.get('command', '')}")
    lines.append("   output:")
    lines += ["     " + line for line in str(f.get("output", "")).split("\n")]
found = ("\n\nThe bugs that it could show:\n\n" + "\n".join(lines) + "\n\n") if findings else " "
if blocked:
    # A review that could not run a part of the project did not see the code, so merge still refuses it.
    save(ready="")
    say(f"review {n} of {short} could not run a part of the project: {blocked.rstrip('.')}." + found
        + "Tell the user. Do not start the demo before a review runs each part that the change touches. "
        "Merge refuses this code until a review runs each such part. The user decides what follows.")
save(reviewed=ready, count=str(n))
if not findings:
    say(f"review {n} of {short} found no bug. {demo}")
found = (f"review {n} of {short} found {len(findings)} bug{'' if len(findings) == 1 else 's'}:\n\n"
         + "\n".join(lines) + "\n\n")
fixed = ("For each finding that you fix, paste its command and its output before and after the fix "
         "into the proof, as \"Check and proof\" says. When all of your fixes are committed, run "
         f"'workbench ready {item}'.")
if n < USER_DECIDES_FROM:
    say(found + "Run the command of each finding again. Drop each finding whose output you cannot "
        f"reproduce. If no finding reproduces: {demo} "
        "Otherwise, fix each finding that reproduces on the branch. Then run its command again. " + fixed)
say(found + f"This was review {n}. From review {USER_DECIDES_FROM} on, the user decides about the "
    "findings. Run the command of each finding again. Show the user each finding, and whether its "
    "output reproduces. Do not fix a finding before the user answers. Then do what the user decided. "
    + fixed + f" If the user decides on no change to the code: {demo}")
PY
)"
