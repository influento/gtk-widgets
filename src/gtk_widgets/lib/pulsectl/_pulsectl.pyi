# Types for the libpulse names that widgets/audio/ uses; the vendored code
# beside it is outside the gate (exclude in .claude/workshop.conf).
import ctypes
from collections.abc import Callable
from typing import Final, Protocol

PA_INVALID: Final[int]
PA_SAMPLE_FLOAT32NE: Final[int]
PA_STREAM_DONT_MOVE: Final[int]
PA_STREAM_PEAK_DETECT: Final[int]
PA_STREAM_ADJUST_LATENCY: Final[int]
PA_STREAM_DONT_INHIBIT_AUTO_SUSPEND: Final[int]
PA_STREAM_CREATING: Final[int]
PA_STREAM_READY: Final[int]

# ctypes pointers to libpulse's opaque structs (POINTER(PA_STREAM), ...): code
# only passes them back to libpulse. typeshed's own type for them is private.
class MainloopPointer: ...
class ContextPointer: ...
class StreamPointer: ...
class ProplistPointer: ...

# What ctypes.byref() returns; typeshed's own type for it is private.
class CRef(Protocol): ...
class SampleSpec(ctypes.Structure): ...
class BufferAttr(ctypes.Structure): ...

class StreamRequestCallback:
    def __init__(
        self, callback: Callable[[StreamPointer, int, int | None], None] = ..., /
    ) -> None: ...

# The runtime names; a class named so would break ruff's naming rule.
PA_SAMPLE_SPEC: type[SampleSpec]
PA_BUFFER_ATTR: type[BufferAttr]
PA_STREAM_REQUEST_CB_T: type[StreamRequestCallback]

class LibPulse:
    class CallError(Exception): ...

    def mainloop_iterate(
        self, m: MainloopPointer, block: int, retval: None, /
    ) -> int: ...
    def mainloop_wakeup(self, m: MainloopPointer, /) -> None: ...
    def proplist_from_string(self, s: str, /) -> ProplistPointer: ...
    def proplist_free(self, p: ProplistPointer, /) -> None: ...
    def stream_new_with_proplist(
        self,
        c: ContextPointer,
        name: str,
        ss: CRef,
        channel_map: None,
        p: ProplistPointer,
        /,
    ) -> StreamPointer: ...
    def stream_set_monitor_stream(
        self, s: StreamPointer, sink_input_idx: int, /
    ) -> int: ...
    def stream_set_read_callback(
        self, s: StreamPointer, cb: StreamRequestCallback, userdata: None, /
    ) -> None: ...
    def stream_connect_record(
        self, s: StreamPointer, dev: str, attr: CRef, flags: int, /
    ) -> int: ...
    def stream_get_state(self, s: StreamPointer, /) -> int: ...
    def stream_peek(self, s: StreamPointer, data: CRef, nbytes: CRef, /) -> int: ...
    def stream_drop(self, s: StreamPointer, /) -> int: ...
    def stream_disconnect(self, s: StreamPointer, /) -> int: ...
    def stream_unref(self, s: StreamPointer, /) -> None: ...

pa: LibPulse
